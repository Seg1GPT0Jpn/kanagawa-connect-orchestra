{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanagawa-connect-orchestra.local/schemas/question_schema.json",
  "title": "問題セット（マスターデータ）",
  "description": "1つのJSONファイル＝1つの問題セット（単元プリント・模試など）。各問題は questions 配列に格納する。数式は LaTeX を $...$（インライン）または $$...$$（ディスプレイ）で記述する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "set_id",
    "title",
    "track",
    "stage",
    "subject",
    "grade",
    "unit_ids",
    "questions",
    "copyright",
    "revision_history"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "set_id": {
      "$ref": "#/$defs/set_id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "track": {
      "$ref": "#/$defs/track"
    },
    "stage": {
      "enum": [
        "junior_high",
        "high_school"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "course": {
      "type": "string",
      "description": "高校の科目コード（curriculum_map の course）。"
    },
    "grade": {
      "$ref": "#/$defs/grade"
    },
    "unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unit_id"
      }
    },
    "time_limit_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "total_points": {
      "type": "number",
      "minimum": 0,
      "description": "指定した場合、各問の配点合計と一致しなければならない（validate_questions.py が検査）。"
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "表紙・冒頭に印刷する注意事項。"
    },
    "exam_spec": {
      "$ref": "#/$defs/exam_spec"
    },
    "sections": {
      "type": "array",
      "description": "大問の構成。問題の section フィールドから参照する。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string"
          },
          "stimulus_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page_break": {
            "type": "boolean",
            "description": "この大問の前で改ページする。"
          },
          "subject": {
            "$ref": "#/$defs/subject"
          },
          "time_limit_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          }
        }
      }
    },
    "stimuli": {
      "type": "array",
      "description": "複数の問題で共有する本文・資料・図・リスニング台本。",
      "items": {
        "$ref": "#/$defs/stimulus"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "copyright": {
      "$ref": "#/$defs/copyright"
    },
    "revision_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "validation": {
      "type": "object",
      "description": "最後に実行した自動検査の結果（validate_questions.py --stamp が書き込む）。",
      "additionalProperties": false,
      "required": [
        "validated_at",
        "validator_version",
        "result"
      ],
      "properties": {
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "validator_version": {
          "type": "string"
        },
        "result": {
          "enum": [
            "pass",
            "pass_with_warnings",
            "fail"
          ]
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "build": {
      "type": "object",
      "description": "PDFビルドの設定上書き。",
      "additionalProperties": false,
      "properties": {
        "paper": {
          "enum": [
            "A4",
            "B5",
            "tablet"
          ]
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "show_points": {
          "type": "boolean"
        },
        "show_difficulty": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "set_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^(JH|HS|CT|SS|EX)-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+-Q\\d{3}$"
    },
    "grade": {
      "enum": [
        "JH1",
        "JH2",
        "JH3",
        "HS1",
        "HS2",
        "HS3"
      ]
    },
    "subject": {
      "enum": [
        "japanese",
        "math",
        "english",
        "science",
        "social",
        "information",
        "integrated"
      ]
    },
    "track": {
      "enum": [
        "pilot",
        "junior_high",
        "tokushoku",
        "mock_exam",
        "high_school",
        "common_test",
        "second_stage"
      ]
    },
    "skill": {
      "enum": [
        "knowledge",
        "vocabulary",
        "grammar",
        "calculation",
        "reading",
        "listening",
        "writing",
        "translation",
        "classics",
        "data_interpretation",
        "thinking",
        "proof",
        "essay",
        "experiment"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rich_text": {
      "type": "string",
      "minLength": 1,
      "description": "プレーンテキスト。改行は \\n。数式は $...$ / $$...$$。下線は [[u:語句]]、空欄は [[blank:記号]]、傍線部は [[mark:記号:語句]]。"
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": {
          "enum": [
            "passage",
            "dialogue",
            "table",
            "figure",
            "listening_script",
            "data",
            "poem",
            "classical_text"
          ]
        },
        "title": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/rich_text"
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "figure": {
          "$ref": "#/$defs/figure"
        },
        "vertical": {
          "type": "boolean",
          "description": "縦書きで組む（国語の本文用）。"
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "meaning"
            ],
            "properties": {
              "term": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "type": "string",
          "description": "出典（オリジナルの場合は「オリジナル」）。"
        },
        "copyright_status": {
          "$ref": "#/$defs/copyright_status"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows"
      ],
      "properties": {
        "caption": {
          "type": "string"
        },
        "header": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alt"
      ],
      "properties": {
        "alt": {
          "type": "string",
          "minLength": 1,
          "description": "図の内容説明（代替テキスト・作図指示）。"
        },
        "svg": {
          "type": "string",
          "pattern": "^<svg[\\s\\S]*</svg>$"
        },
        "caption": {
          "type": "string"
        },
        "height_mm": {
          "type": "number",
          "minimum": 10,
          "maximum": 200
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "text"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "text": {
          "$ref": "#/$defs/rich_text"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "description": "正答。選択式は選択肢ラベル（複数選択・並べ替えは配列）、記述式は模範解答。",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "number"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          ]
        },
        "accepted": {
          "type": "array",
          "description": "別解として正答扱いにする表記。",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "display": {
          "type": "string",
          "description": "解答冊子での表示（省略時は value から生成）。"
        },
        "unit": {
          "type": "string",
          "description": "数値の単位。"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "method"
      ],
      "properties": {
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "method": {
          "enum": [
            "exact",
            "all_or_nothing",
            "partial",
            "rubric"
          ]
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "points"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "partial",
                  "rubric"
                ]
              }
            }
          },
          "then": {
            "required": [
              "rubric"
            ],
            "properties": {
              "rubric": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "score"
      ],
      "properties": {
        "level": {
          "enum": [
            "basic",
            "standard",
            "advanced"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": "basic"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "maximum": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "standard"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "advanced"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "minimum": 4
              }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "auto_checked",
            "self_reviewed",
            "expert_reviewed",
            "approved",
            "rejected"
          ]
        },
        "checked_by": {
          "type": "string"
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "schema",
              "duplicate",
              "calc_check",
              "answer_consistency",
              "self_review",
              "expert_review",
              "student_trial"
            ]
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "calc_check": {
      "type": "object",
      "description": "検算補助。expression を安全な式評価器（sympy）で評価し expected と一致するかを検査する。",
      "additionalProperties": false,
      "required": [
        "expression",
        "expected"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "compare": {
          "enum": [
            "value",
            "set",
            "expand",
            "numeric"
          ],
          "default": "value"
        },
        "note": {
          "type": "string"
        },
        "target": {
          "enum": [
            "answer",
            "intermediate"
          ],
          "default": "answer",
          "description": "answer: 数値・短答の問題では expected が正答（answer.value）と一致することも検査する。intermediate: 途中計算の検算（正答とは照合しない）。"
        }
      }
    },
    "copyright_status": {
      "enum": [
        "original",
        "public_domain",
        "licensed",
        "quotation",
        "needs_clearance"
      ]
    },
    "copyright": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "holder"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/copyright_status"
        },
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "author",
        "changes"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "exam_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reference"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "reference": {
          "type": "string",
          "description": "準拠・参考にした出題仕様。"
        },
        "answer_format": {
          "enum": [
            "mark_sheet",
            "written",
            "mixed"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "grade",
        "subject",
        "unit_id",
        "skills",
        "evaluation_aspect",
        "question_type",
        "stem",
        "answer",
        "explanation",
        "scoring",
        "difficulty",
        "verification",
        "copyright"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/question_id"
        },
        "number": {
          "type": "string",
          "description": "印刷上の問題番号（例: 問1(2)）。省略時は連番。"
        },
        "section": {
          "type": "string"
        },
        "grade": {
          "$ref": "#/$defs/grade"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "unit_id": {
          "$ref": "#/$defs/unit_id"
        },
        "topic": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skill"
          }
        },
        "evaluation_aspect": {
          "enum": [
            "knowledge_skill",
            "thinking_judgment_expression"
          ]
        },
        "question_type": {
          "enum": [
            "multiple_choice",
            "multiple_select",
            "true_false",
            "short_answer",
            "numeric",
            "fill_in_blank",
            "ordering",
            "descriptive",
            "proof",
            "essay"
          ]
        },
        "stimulus_ref": {
          "type": "string"
        },
        "stimulus": {
          "$ref": "#/$defs/stimulus"
        },
        "stem": {
          "$ref": "#/$defs/rich_text"
        },
        "figure": {
          "$ref": "#/$defs/figure"
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "answer": {
          "$ref": "#/$defs/answer"
        },
        "explanation": {
          "$ref": "#/$defs/rich_text"
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        },
        "difficulty": {
          "$ref": "#/$defs/difficulty"
        },
        "answer_space": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "height_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 250
            },
            "char_grid": {
              "type": "integer",
              "minimum": 10,
              "maximum": 800,
              "description": "字数制限付き記述のマス目数。"
            }
          }
        },
        "estimated_time_sec": {
          "type": "integer",
          "minimum": 10
        },
        "calc_check": {
          "$ref": "#/$defs/calc_check"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "copyright": {
          "$ref": "#/$defs/copyright"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "question_type": {
                "enum": [
                  "multiple_choice",
                  "multiple_select",
                  "true_false"
                ]
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "enum": [
                  "multiple_select",
                  "ordering"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "properties": {
                  "value": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "enum": [
                  "descriptive",
                  "proof",
                  "essay"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "scoring": {
                "properties": {
                  "method": {
                    "enum": [
                      "rubric",
                      "partial"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
