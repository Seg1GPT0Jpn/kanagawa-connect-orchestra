rules_version = '2';

// 練習お助けアプリ（Firebase プロジェクト kco-practice）の Firestore セキュリティルール
//
//  users/{uid}/practiceRecords/{recordId} … 練習記録。本人だけが読み書きできる
//    ・削除はしない（同期のため、削除済みの印 deleted: true を付けて残す）
//    ・古い版での上書きはできない（updatedAt が今より小さい書き込みは拒否）
//    ・serverUpdatedAt はサーバーの時刻（同期で「前回以降の変更」を取るのに使う）
//  それ以外は読み書きできない
//
// テスト：practice-app/rules-test で `npm test`
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validRecord(uid, recordId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'ownerUid', 'practicedOn', 'startedAt', 'ruleSetId',
                               'plannedMinutes', 'actualSeconds', 'note', 'updatedAt',
                               'updatedBy', 'deleted', 'serverUpdatedAt'])
        && d.keys().hasAll(['id', 'ownerUid', 'practicedOn', 'startedAt', 'ruleSetId',
                            'plannedMinutes', 'actualSeconds', 'note', 'updatedAt',
                            'updatedBy', 'deleted', 'serverUpdatedAt'])
        && recordId.matches('^[A-Za-z0-9]{1,40}$')
        && d.id == recordId
        && d.ownerUid == uid
        && d.practicedOn is string && d.practicedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.startedAt is int && d.startedAt >= 0
        && d.ruleSetId is string && d.ruleSetId.size() > 0 && d.ruleSetId.size() <= 50
        && d.plannedMinutes is map && d.plannedMinutes.size() <= 30
        && d.actualSeconds is map && d.actualSeconds.size() <= 30
        && d.note is string && d.note.size() <= 500
        && d.updatedAt is int && d.updatedAt >= 0
        && d.updatedBy is string && d.updatedBy.size() > 0 && d.updatedBy.size() <= 64
        && d.deleted is bool
        && d.serverUpdatedAt == request.time;
    }

    match /users/{uid}/practiceRecords/{recordId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && validRecord(uid, recordId);
      allow update: if signedInAs(uid) && validRecord(uid, recordId)
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if false;
    }
  }
}
