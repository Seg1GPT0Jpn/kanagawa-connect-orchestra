      {
        "id": "th1",
        "kind": "theorem",
        "title": "三角比の相互関係",
        "formula": "$$\\sin^2\\theta+\\cos^2\\theta=1,\\qquad \\tan\\theta=\\dfrac{\\sin\\theta}{\\cos\\theta},\\qquad 1+\\tan^2\\theta=\\dfrac{1}{\\cos^2\\theta}$$",
        "conditions": [
          "$\\tan$ を含む式は $\\theta\\neq90^\\circ$ のとき",
          "$\\sin\\theta$ から $\\cos\\theta$ を求めるときは、$\\theta$ が鋭角か鈍角かで符号が決まる"
        ],
        "proof_steps": [
          "単位円上の点 P$(\\cos\\theta,\\,\\sin\\theta)$ は $x^2+y^2=1$ を満たすので $\\cos^2\\theta+\\sin^2\\theta=1$。",
          "定義より $\\tan\\theta=\\dfrac{y}{x}=\\dfrac{\\sin\\theta}{\\cos\\theta}$。",
          "第1式の両辺を $\\cos^2\\theta\\ (\\neq0)$ で割ると $\\tan^2\\theta+1=\\dfrac{1}{\\cos^2\\theta}$。"
        ],
        "teacher_points": [
          {
            "point": "3つの式は暗記ではなく「単位円の方程式」から1行で導けることを強調する。"
          }
        ]
      },
      {
        "id": "dv1",
        "kind": "derivation",
        "title": "$180^\\circ-\\theta$ の三角比",
        "proof_steps": [
          "点 P$(\\cos\\theta,\\,\\sin\\theta)$ と $y$ 軸に関して対称な点は Q$(-\\cos\\theta,\\,\\sin\\theta)$。",
          "OQ と $x$ 軸の正の向きのなす角は $180^\\circ-\\theta$。",
          "よって $\\sin(180^\\circ-\\theta)=\\sin\\theta,\\ \\cos(180^\\circ-\\theta)=-\\cos\\theta,\\ \\tan(180^\\circ-\\theta)=-\\tan\\theta$。"
        ],
        "body": "鈍角の三角比は、この公式で鋭角の三角比に直して求める。",
        "teacher_points": [
          {
            "point": "$\\sin$ だけ符号が変わらない理由を、点の $y$ 座標が変わらないことで説明する。"
          }
        ]
      },
      {
        "id": "th2",
        "kind": "theorem",
        "title": "正弦定理",
        "formula": "$$\\dfrac{a}{\\sin A}=\\dfrac{b}{\\sin B}=\\dfrac{c}{\\sin C}=2R\\qquad(R\\text{ は外接円の半径})$$",
        "conditions": [
          "1辺とその両端の角（または対角）が分かるとき、ほかの辺を求めるのに使う",
          "$\\sin B$ から $B$ を求めるときは、鋭角・鈍角の2通りがありうる"
        ],
        "proof_steps": [
          "$A$ が鋭角のとき：外接円の直径 BD を引くと、円周角の定理より $\\angle\\mathrm{BDC}=A$、$\\angle\\mathrm{BCD}=90^\\circ$。",
          "直角三角形 BCD で $\\sin A=\\dfrac{a}{2R}$、よって $\\dfrac{a}{\\sin A}=2R$。",
          "$A$ が鈍角のときは円に内接する四角形の性質から $\\angle\\mathrm{BDC}=180^\\circ-A$ となり、$\\sin(180^\\circ-A)=\\sin A$ より同じ式が成り立つ（直角のときは $a=2R$）。",
          "B・C についても同様なので定理が成り立つ。"
        ],
        "teacher_points": [
          {
            "point": "証明の要点は「直径に対する円周角は直角」。中学の円周角の定理を想起させる。",
            "ask": "直径 BD を引くと、どの角が直角になるか。"
          }
        ],
        "figure": {
          "alt": "外接円と直径BD",
          "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 144 144\" width=\"144\" height=\"144\" font-family=\"serif\" font-size=\"12\"><circle cx=\"72\" cy=\"72\" r=\"56\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"38.4\" y1=\"27.2\" x2=\"23.56\" y2=\"100\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"23.56\" y1=\"100\" x2=\"120.44\" y2=\"100\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"120.44\" y1=\"100\" x2=\"38.4\" y2=\"27.2\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"23.56\" y1=\"100\" x2=\"120.44\" y2=\"44\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"120.44\" y1=\"44\" x2=\"120.44\" y2=\"100\" stroke=\"#000\" stroke-width=\"1.2\"/><text x=\"27.12\" y=\"22.95\">A</text><text x=\"10.17\" y=\"109.73\">B</text><text x=\"125.5\" y=\"110.25\">C</text><text x=\"126.11\" y=\"42.76\">D</text><text x=\"60.72\" y=\"84.24\">O</text></svg>"
        }
      },
      {
        "id": "th3",
        "kind": "theorem",
        "title": "余弦定理",
        "formula": "$$a^2=b^2+c^2-2bc\\cos A,\\qquad \\cos A=\\dfrac{b^2+c^2-a^2}{2bc}$$",
        "conditions": [
          "2辺とその間の角から残りの辺を求めるとき",
          "3辺から角を求めるとき",
          "$A=90^\\circ$ のとき三平方の定理になる"
        ],
        "proof_steps": [
          "A を原点、AB を $x$ 軸上にとり、B$(c,\\,0)$、C$(b\\cos A,\\,b\\sin A)$ とする。",
          "$a^2=\\mathrm{BC}^2=(b\\cos A-c)^2+(b\\sin A)^2=b^2(\\cos^2A+\\sin^2A)-2bc\\cos A+c^2$。",
          "$\\cos^2A+\\sin^2A=1$ より $a^2=b^2+c^2-2bc\\cos A$。$A$ が鈍角でも同じ計算が成り立つ。"
        ],
        "teacher_points": [
          {
            "point": "三平方の定理の「補正項」が $-2bc\\cos A$ であり、$A$ が鈍角なら $\\cos A<0$ で $a^2$ が大きくなることを図で確認させる。"
          }
        ]
      },
      {
        "id": "th4",
        "kind": "theorem",
        "title": "三角形の面積",
        "formula": "$$S=\\dfrac{1}{2}bc\\sin A=\\dfrac{1}{2}ca\\sin B=\\dfrac{1}{2}ab\\sin C$$",
        "conditions": [
          "2辺とその間の角が分かるとき",
          "$\\sin$ を使う（$\\cos$ ではない）"
        ],
        "proof_steps": [
          "辺 AB を底辺とすると、高さは C から直線 AB に下ろした垂線の長さ $h=b\\sin A$（鈍角でも $\\sin(180^\\circ-A)=\\sin A$ より同じ）。",
          "$S=\\dfrac{1}{2}ch=\\dfrac{1}{2}bc\\sin A$。"
        ],
        "teacher_points": [
          {
            "point": "「高さ ＝ 斜辺 × sin」という見方を、図に高さを書き込ませて定着させる。"
          }
        ]
      },
      {
        "id": "ex1",
        "kind": "example",
        "title": "例題1　正弦定理",
        "example": {
          "problem": "$\\triangle\\mathrm{ABC}$ で $a=6,\\ A=45^\\circ,\\ B=60^\\circ$ のとき、$b$ と外接円の半径 $R$ を求めよ。",
          "steps": [
            "正弦定理 $\\dfrac{a}{\\sin A}=\\dfrac{b}{\\sin B}$ より $b=\\dfrac{6\\sin60^\\circ}{\\sin45^\\circ}=\\dfrac{6\\cdot\\frac{\\sqrt3}{2}}{\\frac{\\sqrt2}{2}}=3\\sqrt6$。",
            "$2R=\\dfrac{a}{\\sin A}=\\dfrac{6}{\\frac{\\sqrt2}{2}}=6\\sqrt2$ より $R=3\\sqrt2$。"
          ],
          "answer": "$b=3\\sqrt6,\\ R=3\\sqrt2$",
          "thinking": "1辺と2角が分かっている → 正弦定理。"
        },
        "teacher_points": [
          {
            "point": "分数の中の分数の処理を丁寧に板書する。"
          }
        ]
      },
      {
        "id": "ex2",
        "kind": "example",
        "title": "例題2　余弦定理で角を求める",
        "example": {
          "problem": "$\\triangle\\mathrm{ABC}$ で $a=7,\\ b=5,\\ c=3$ のとき、$A$ を求めよ。",
          "steps": [
            "$\\cos A=\\dfrac{b^2+c^2-a^2}{2bc}=\\dfrac{25+9-49}{30}=-\\dfrac{1}{2}$。",
            "$0^\\circ<A<180^\\circ$ より $A=120^\\circ$。"
          ],
          "answer": "$A=120^\\circ$",
          "thinking": "3辺が分かっている → 余弦定理の変形 $\\cos A=\\dfrac{b^2+c^2-a^2}{2bc}$。"
        },
        "misconceptions": [
          {
            "wrong": "$\\cos A=-\\dfrac12$ だから $A=60^\\circ$",
            "correct": "$\\cos$ が負なら鈍角。$A=120^\\circ$"
          }
        ]
      },
      {
        "id": "ex3",
        "kind": "example",
        "title": "例題3　面積",
        "example": {
          "problem": "$\\triangle\\mathrm{ABC}$ で $b=4,\\ c=5,\\ A=120^\\circ$ のとき、面積 $S$ を求めよ。",
          "steps": [
            "$S=\\dfrac12bc\\sin A=\\dfrac12\\cdot4\\cdot5\\cdot\\sin120^\\circ$。",
            "$\\sin120^\\circ=\\sin60^\\circ=\\dfrac{\\sqrt3}{2}$ より $S=5\\sqrt3$。"
          ],
          "answer": "$5\\sqrt3$"
        }
      },
