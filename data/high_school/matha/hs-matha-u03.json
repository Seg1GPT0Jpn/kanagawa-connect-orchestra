      "evaluation_aspect": "thinking_judgment_expression",
      "question_type": "proof",
      "stem": "$n$ が整数のとき、$n^3-n$ は 6 の倍数であることを証明しなさい。",
      "answer": {
        "value": "$n^3-n=(n-1)n(n+1)$ は連続する3つの整数の積である。連続する2つの整数の中には必ず偶数があるので2の倍数、連続する3つの整数の中には必ず3の倍数があるので3の倍数である。2と3は互いに素なので、$n^3-n$ は6の倍数である。"
      },
      "explanation": "因数分解して「連続する整数の積」と見ることがポイント。$n$ を 6 で割った余りで場合分けしてもよい。",
      "scoring": {
        "points": 5,
        "method": "rubric",
        "rubric": [
          {
            "criterion": "$(n-1)n(n+1)$ と因数分解している",
            "points": 2
          },
          {
            "criterion": "2の倍数かつ3の倍数であることを示している",
            "points": 2
          },
          {
            "criterion": "6の倍数と結論づけている",
            "points": 1
          }
        ]
      },
      "difficulty": {
        "level": "advanced",
        "score": 4
      },
      "answer_space": {
        "lines": 6
      },
      "calc_check": {
        "expression": "factor(n**3-n)",
        "expected": "n*(n-1)*(n+1)",
        "compare": "expand",
        "target": "intermediate"
      },
